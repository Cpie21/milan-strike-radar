              "key": "is_test",
              "type": "event",
              "operator": "exact",
              "value": [
                "false"
              ]
            },
            {
              "key": "analytics_version",
              "type": "event",
              "operator": "gt",
              "value": 1
            },
            {
              "type": "hogql",
              "key": "coalesce(properties.$session_id, '') NOT IN (SELECT properties.$session_id FROM events WHERE timestamp >= now() - INTERVAL 30 DAY AND properties.is_test = true AND properties.$session_id IS NOT NULL GROUP BY properties.$session_id)"
            },
            {
              "type": "hogql",
              "key": "event IN ('product_page_viewed','strike_date_selected','city_selected','strike_sources_toggled','source_link_clicked','tool_sheet_opened','calendar_subscription_requested','widget_copy_succeeded','ai_query_submitted','ai_result_viewed','ai_result_day_opened')"
