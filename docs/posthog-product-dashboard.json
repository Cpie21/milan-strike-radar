    {
      "name": "同一张卡片的来源与分享行动",
      "description": "固定滚动30天；按card_id+匿名session去重。卡片至少看1秒→来源可见/外链/分享结果。是相关事件存在表，不冒充严格顺序用户漏斗。",
      "query": {
        "kind": "DataVisualizationNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "SELECT transport_mode, countIf(seen>0) AS viewed_card_sessions, countIf(seen>0 AND evidence>0) AS sources_viewed_card_sessions, countIf(seen>0 AND clicked>0) AS source_clicked_card_sessions, countIf(seen>0 AND shared>0) AS share_completed_card_sessions FROM (SELECT properties.card_id AS card, properties.$session_id AS sid, upper(argMax(properties.transport_type,timestamp)) AS transport_mode, max(event='strike_card_attention' AND properties.milestone_seconds=1) AS seen, max(event='strike_sources_viewed') AS evidence, max(event='source_link_clicked') AS clicked, max(event='strike_share_outcome' AND properties.outcome='completed') AS shared FROM events WHERE timestamp >= now() - INTERVAL 30 DAY AND properties.is_test = false AND properties.analytics_version > 1 AND coalesce(properties.$session_id, '') NOT IN (SELECT properties.$session_id FROM events WHERE timestamp >= now() - INTERVAL 30 DAY AND properties.is_test = true AND properties.$session_id IS NOT NULL GROUP BY properties.$session_id) AND properties.card_id IS NOT NULL AND properties.$session_id IS NOT NULL AND event IN ('strike_card_attention','strike_sources_viewed','source_link_clicked','strike_share_outcome') GROUP BY card,sid) GROUP BY transport_mode ORDER BY viewed_card_sessions DESC"
        },
        "display": "ActionsTable"
      },
      "id": 6399116,
      "shortId": "xbx7Jpin"
    },
    {
      "name": "每次反馈提交的保存与失败",
      "description": "固定滚动30天；按submission_id去重，双击不重复提交。success响应才saved，不发送反馈文字。入库离线缺receipt记未知。",
      "query": {
        "kind": "DataVisualizationNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "SELECT multiIf(saved>0,'SAVED',failed>0,'FAILED','NO_RECEIPT') AS outcome,count() AS submissions FROM (SELECT properties.submission_id AS submission, max(event='support_feedback_submitted') AS submitted, max(event='support_feedback_saved') AS saved, max(event='support_feedback_failed') AS failed FROM events WHERE timestamp >= now() - INTERVAL 30 DAY AND properties.is_test = false AND properties.analytics_version > 1 AND coalesce(properties.$session_id, '') NOT IN (SELECT properties.$session_id FROM events WHERE timestamp >= now() - INTERVAL 30 DAY AND properties.is_test = true AND properties.$session_id IS NOT NULL GROUP BY properties.$session_id) AND properties.submission_id IS NOT NULL AND event IN ('support_feedback_submitted','support_feedback_saved','support_feedback_failed') GROUP BY submission) WHERE submitted>0 GROUP BY outcome ORDER BY submissions DESC"
        },
        "display": "ActionsTable"
      },
      "id": 6399117,
      "shortId": "o182EpNE"
    }
  ]
